# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Created automatically on first start (docker/entrypoint.sh)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345

# --- PostgreSQL (host is overridden to "db" by docker-compose) ---
POSTGRES_DB=docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick any model from https://openrouter.ai/collections/free-models
LLM_MODEL=
# Optional: comma-separated fallback models, tried in order if the main one fails
LLM_FALLBACK_MODELS=
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# Must match the model output size AND the VectorField in documents/models.py
EMBEDDING_DIM=1024

# --- RAG tuning (optional) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
